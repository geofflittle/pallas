#!/bin/sh
# Rehearse every job pallas's CI workflow defines, in workflow order, against
# whatever the tree is currently checked out at. Each job's exit code is
# printed, so a job that fails says so rather than being read as one that
# produced no complaint.
#
# The three Test jobs in the workflow are one matrix over three operating
# systems running the same three commands. This box is Linux, so it rehearses
# the ubuntu leg and says so about the other two rather than claiming them.
#
# Each job also prints the number of crates it compiled, because a job that
# passes having compiled nothing is a cached replay and not a result, and a run
# whose jobs compiled nothing between them is refused rather than reported.
# Cargo keeps one target directory across runs and decides freshness by mtime,
# so every run touches the source tree before the first cargo command
# (CI_TOUCH=0 skips it).
#
# A run that reaches its summary exits 0 only when every job passed and 1 when
# any job FAILed, so a caller reading the exit code alone cannot read a red run
# as a green one. The refusals keep their own codes, 2 for a tree with no usable
# head and 3 for a run that compiled nothing, and both are decided before the
# FAIL count. CI_FAIL_JOB names the jobs whose commands are replaced by false,
# which reaches the FAIL path without editing a job.
#
# The source tree and the runner are the ones plc.sh mounts, and CI_PROBE_AREA
# moves both of them and the logs to that area at once, so the two can never
# name different trees.
SRC=/opt/build/pallas-ci
RUNNER=/opt/build/plc.sh
LOGDIR=/opt/build/ci-logs
MSRV_TARGET=/opt/build/target-ci-msrv
CI_TOUCH=${CI_TOUCH:-1}
CI_FAIL_JOB=${CI_FAIL_JOB:-}
if [ -n "$CI_PROBE_AREA" ]; then
  SRC=$CI_PROBE_AREA/src
  RUNNER=$CI_PROBE_AREA/run.sh
  LOGDIR=$CI_PROBE_AREA/ci-logs
  MSRV_TARGET=$CI_PROBE_AREA/target-msrv
fi
resolve_head() {
  DIR=$1
  HEAD=$(git -C "$DIR" rev-parse HEAD 2>/dev/null)
  HEAD_FROM=repository
  if [ -z "$HEAD" ]; then
    HEAD=$(cat "$DIR/HEAD_SHA" 2>/dev/null)
    HEAD_FROM=file
  fi
  if [ -z "$HEAD" ]; then
    echo "refused $DIR carries no head, neither a repository HEAD nor a HEAD_SHA file was found"
    return 2
  fi
  if [ "$HEAD_FROM" = file ] && [ "$(printf '%s' "$HEAD" | /bin/grep -cE '^[0-9a-f]{40}$')" -ne 1 ]; then
    echo "refused $DIR/HEAD_SHA holds [$HEAD], which is not forty hexadecimal characters"
    return 2
  fi
  return 0
}
if [ -n "$CI_HEAD_PROBE" ]; then
  if resolve_head "$CI_HEAD_PROBE"; then
    echo "accepted $CI_HEAD_PROBE head $HEAD from $HEAD_FROM"
    exit 0
  fi
  exit 2
fi
resolve_head "$SRC" || exit $?
mkdir -p "$LOGDIR"
COMPILED_TOTAL=0
JOBS=0
FAILED=0

run() {
  NAME=$1
  shift
  LOG=$LOGDIR/$NAME.log
  case " $CI_FAIL_JOB " in
    *" $NAME "*) false > "$LOG" 2>&1 ;;
    *) "$RUNNER" "$@" > "$LOG" 2>&1 ;;
  esac
  CODE=$?
  JOBS=$((JOBS + 1))
  if [ "$CODE" -eq 0 ]; then RESULT=pass; else RESULT=FAIL; FAILED=$((FAILED + 1)); fi
  COMPILED=$(/bin/grep -cE "^ +(Compiling|Checking|Documenting) " "$LOG" 2>/dev/null)
  case "$COMPILED" in '' | *[!0-9]*) COMPILED=0 ;; esac
  COMPILED_TOTAL=$((COMPILED_TOTAL + COMPILED))
  echo "$NAME $RESULT exit=$CODE crates=$COMPILED"
}

echo "tree $(printf '%.7s' "$HEAD") at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -n "$CI_PROBE_AREA" ]; then
  echo "probe area $CI_PROBE_AREA, source $SRC and runner $RUNNER, not the default tree"
fi
if [ -n "$CI_FAIL_JOB" ]; then
  echo "jobs [$CI_FAIL_JOB] replaced by false through CI_FAIL_JOB, this run is a probe of the failure path"
fi
if [ "$CI_TOUCH" = 1 ]; then
  TOUCHED=$(find "$SRC" -type f | wc -l)
  find "$SRC" -type f -exec touch {} +
  echo "touched $TOUCHED files under $SRC"
else
  echo "touch skipped by CI_TOUCH=$CI_TOUCH, cargo may replay cached artifacts"
fi

run fmt               cargo fmt --all --check
run clippy            cargo clippy --workspace --all-targets -- -D warnings
RUSTDOCFLAGS="-D warnings" run docs cargo doc --workspace --no-deps
run test-build        cargo build --workspace --all-targets
run test-run          cargo test --workspace
run test-blueprint    cargo test -p pallas-network -p pallas-network2 --features blueprint
run features-nodefault cargo check --workspace --all-targets --no-default-features
run features-all      cargo check --workspace --all-targets --all-features
run isolated          cargo check -p pallas-primitives --no-default-features

CI_TARGET=$MSRV_TARGET run msrv cargo +1.88 check --workspace --all-targets

echo "done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
df -h / | tail -1
if [ "$COMPILED_TOTAL" -eq 0 ]; then
  echo "replayed cache, the jobs compiled zero crates between them, so these results are artifacts of an earlier run and not a pass"
  echo "exit 3, no job compiled anything, so this run is not a rehearsal"
  exit 3
fi
if [ "$FAILED" -ne 0 ]; then
  echo "exit 1, $FAILED of $JOBS jobs FAILed"
  exit 1
fi
echo "exit 0, all $JOBS jobs passed"
exit 0
