cabal-version: 3.0
name: conformance-gen
version: 0.1.0.0
build-type: Simple

executable conformance-gen
  main-is: Main.hs
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -O1 -Wall -Wno-unused-imports
  build-depends:
    base,
    aeson,
    base16-bytestring,
    bytestring,
    cborg,
    containers,
    microlens,
    text,
    QuickCheck,
    antigen,
    cuddle,
    cardano-crypto-class,
    cardano-data,
    cardano-slotting,
    cardano-strict-containers,
    cardano-ledger-binary:{cardano-ledger-binary, testlib},
    cardano-ledger-core,
    cardano-ledger-allegra,
    cardano-ledger-alonzo,
    cardano-ledger-babbage,
    cardano-ledger-mary,
    plutus-ledger-api,
    cardano-ledger-conway,
    cardano-ledger-dijkstra:{cardano-ledger-dijkstra, testlib, cddl},
    cardano-protocol:{cardano-protocol, testlib},
